rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection health check document
    match /test/{testId} {
      allow read: if true;
    }

    // User profile documents
    match /users/{userId} {
      function isValidUser(data) {
        return data.id == userId
          && data.id is string && data.id.size() <= 128
          && data.email is string && data.email.size() <= 256
          && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
          && (!('role' in data) || (data.role in ['freelancer', 'client']))
          && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'email']);
      allow delete: if isOwner(userId);
    }

    // File records
    match /files/{fileId} {
      function isValidFile(data) {
        return isValidId(data.id)
          && data.name is string && data.name.size() > 0 && data.name.size() <= 256
          && data.size is int && data.size >= 0 && data.size <= 25000000
          && data.ownerId == request.auth.uid
          && (!('type' in data) || (data.type is string && data.type.size() <= 128))
          && (!('category' in data) || (data.category is string && data.category.size() <= 50))
          && (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 120))
          && (!('fileData' in data) || (data.fileData is string && data.fileData.size() <= 850000))
          && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
          && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
      }

      allow get: if isSignedIn() && isValidId(fileId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(fileId) && isValidFile(incoming());
      allow update: if isSignedIn() && isValidId(fileId) && isValidFile(incoming())
        && incoming().ownerId == existing().ownerId
        && existing().ownerId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'clientName', 'updatedAt', 'fileData', 'size', 'type']);
      allow delete: if isSignedIn() && isValidId(fileId) && existing().ownerId == request.auth.uid;
    }

    // Client records / portal spaces
    match /clients/{clientId} {
      function isValidClient(data) {
        return isValidId(data.id)
          && data.name is string && data.name.size() > 0 && data.name.size() <= 120
          && data.ownerId == request.auth.uid
          && (!('email' in data) || (data.email is string && data.email.size() <= 256))
          && (!('company' in data) || (data.company is string && data.company.size() <= 120))
          && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
      }

      allow get: if isSignedIn() && isValidId(clientId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(clientId) && isValidClient(incoming());
      allow update: if isSignedIn() && isValidId(clientId) && isValidClient(incoming())
        && incoming().ownerId == existing().ownerId
        && existing().ownerId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'company']);
      allow delete: if isSignedIn() && isValidId(clientId) && existing().ownerId == request.auth.uid;
    }
  }
}
