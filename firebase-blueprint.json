{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and portal role metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": {
          "type": "string",
          "enum": ["admin", "professor", "student", "freelancer", "client"],
          "maxLength": 30
        },
        "department": { "type": "string", "maxLength": 120 },
        "studentCode": { "type": "string", "maxLength": 32 },
        "photoDataUrl": { "type": "string", "maxLength": 150000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "role"]
    },
    "DirectoryEntry": {
      "title": "Campus Directory Entry",
      "description": "Non-PII campus roster record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "professor", "student"], "maxLength": 30 },
        "department": { "type": "string", "maxLength": 120 },
        "studentCode": { "type": "string", "maxLength": 32 },
        "campusScope": { "type": "string", "maxLength": 32 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "displayName", "role", "campusScope"]
    },
    "Course": {
      "title": "Academic Course",
      "description": "Course schedule, room, building, and assigned professor",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 24 },
        "title": { "type": "string", "maxLength": 140 },
        "department": { "type": "string", "maxLength": 100 },
        "instructorId": { "type": "string", "maxLength": 128 },
        "instructorName": { "type": "string", "maxLength": 120 },
        "room": { "type": "string", "maxLength": 60 },
        "building": { "type": "string", "maxLength": 80 },
        "scheduleDays": { "type": "string", "maxLength": 60 },
        "startTime": { "type": "string", "maxLength": 20 },
        "endTime": { "type": "string", "maxLength": 20 },
        "capacity": { "type": "integer" },
        "enrolledCount": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "archived"], "maxLength": 24 },
        "campusScope": { "type": "string", "maxLength": 32 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "code", "title", "instructorId", "room", "building", "startTime", "endTime", "status", "campusScope", "createdBy", "createdAt"]
    },
    "ClassSession": {
      "title": "Class Session",
      "description": "Scheduled or active class session with room and check-in code",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseCode": { "type": "string", "maxLength": 24 },
        "courseTitle": { "type": "string", "maxLength": 140 },
        "professorId": { "type": "string", "maxLength": 128 },
        "professorName": { "type": "string", "maxLength": 120 },
        "room": { "type": "string", "maxLength": 60 },
        "building": { "type": "string", "maxLength": 80 },
        "sessionDate": { "type": "string", "maxLength": 32 },
        "startTime": { "type": "string", "maxLength": 20 },
        "endTime": { "type": "string", "maxLength": 20 },
        "checkInCode": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["scheduled", "active", "completed"], "maxLength": 24 },
        "campusScope": { "type": "string", "maxLength": 32 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "courseId", "courseCode", "courseTitle", "professorId", "room", "building", "sessionDate", "startTime", "endTime", "checkInCode", "status", "campusScope", "createdBy", "createdAt"]
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "Student check-in and QR scan record for a class session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseCode": { "type": "string", "maxLength": 24 },
        "courseTitle": { "type": "string", "maxLength": 140 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 120 },
        "professorId": { "type": "string", "maxLength": 128 },
        "room": { "type": "string", "maxLength": 60 },
        "building": { "type": "string", "maxLength": 80 },
        "sessionDate": { "type": "string", "maxLength": 32 },
        "scanMethod": { "type": "string", "enum": ["qr", "code", "manual"], "maxLength": 16 },
        "status": { "type": "string", "enum": ["present", "late", "absent", "excused"], "maxLength": 24 },
        "checkedInAt": { "type": "string", "maxLength": 64 },
        "campusScope": { "type": "string", "maxLength": 32 },
        "createdBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "sessionId", "courseId", "courseCode", "studentId", "studentName", "professorId", "status", "checkedInAt", "campusScope", "createdBy"]
    },
    "Announcement": {
      "title": "Campus or Subject Announcement",
      "description": "Official school-wide announcements posted by Admin or subject-specific announcements posted by Professor",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 140 },
        "message": { "type": "string", "maxLength": 2000 },
        "scope": { "type": "string", "enum": ["official", "subject"], "maxLength": 24 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseCode": { "type": "string", "maxLength": 24 },
        "courseTitle": { "type": "string", "maxLength": 140 },
        "activityDate": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "enum": ["info", "room_change", "quiz", "no_class", "official"], "maxLength": 24 },
        "photoCount": { "type": "integer" },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 120 },
        "authorRole": { "type": "string", "enum": ["admin", "professor"], "maxLength": 24 },
        "campusScope": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "message", "scope", "courseId", "courseCode", "authorId", "authorName", "authorRole", "campusScope", "createdAt"]
    },
    "AnnouncementPhoto": {
      "title": "Announcement Photo Attachment",
      "description": "Validated image attachment (500 KB - 3 MB original, max 4 per announcement)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "announcementId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "mimeType": { "type": "string", "maxLength": 64 },
        "sizeBytes": { "type": "integer" },
        "orderIndex": { "type": "integer" },
        "dataUrl": { "type": "string", "maxLength": 550000 },
        "authorId": { "type": "string", "maxLength": 128 },
        "campusScope": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "announcementId", "name", "mimeType", "sizeBytes", "orderIndex", "dataUrl", "authorId", "campusScope", "createdAt"]
    },
    "AnnouncementReaction": {
      "title": "Announcement Reaction",
      "description": "Student or user acknowledgment reaction on a notice (Got it / Thanks)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "announcementId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "gotIt": { "type": "boolean" },
        "thanks": { "type": "boolean" },
        "campusScope": { "type": "string", "maxLength": 32 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "announcementId", "userId", "gotIt", "thanks", "campusScope", "updatedAt"]
    },
    "AccountRequest": {
      "title": "Campus Account Request",
      "description": "Newly created Student or Professor accounts awaiting or completed Admin ID review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["professor", "student"], "maxLength": 24 },
        "department": { "type": "string", "maxLength": 120 },
        "studentCode": { "type": "string", "maxLength": 32 },
        "photoDataUrl": { "type": "string", "maxLength": 150000 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "maxLength": 24 },
        "source": { "type": "string", "enum": ["self_signup", "admin_created"], "maxLength": 24 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "reviewedAt": { "type": "string", "maxLength": 64 },
        "campusScope": { "type": "string", "maxLength": 32 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "fullName", "email", "role", "status", "source", "campusScope", "createdBy", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Private user profiles" },
    "/directory/{userId}": { "schema": "DirectoryEntry", "description": "Non-PII campus roster" },
    "/courses/{courseId}": { "schema": "Course", "description": "Academic courses and room schedules" },
    "/sessions/{sessionId}": { "schema": "ClassSession", "description": "Scheduled and active sessions" },
    "/attendance/{recordId}": { "schema": "AttendanceRecord", "description": "Student attendance and QR scan records" },
    "/announcements/{announcementId}": { "schema": "Announcement", "description": "Official Admin and Professor subject announcements" },
    "/announcementPhotos/{photoId}": { "schema": "AnnouncementPhoto", "description": "Validated photo attachments for official announcements" },
    "/announcementReactions/{reactionId}": { "schema": "AnnouncementReaction", "description": "User reactions on announcements" },
    "/accountRequests/{requestId}": { "schema": "AccountRequest", "description": "Student and Professor account creation and Admin approval queue" }
  }
}
